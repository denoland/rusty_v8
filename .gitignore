**/*.rs.bk
**/*.orig

.envrc

/.vscode/
/.idea/
/target/
/.cipd/

# Checksum records written next to src bindings downloaded by build.rs.
# The bindings themselves (gen/src_binding_*.rs) must NOT be ignored: the
# publish CI job drops them into gen/ and `cargo publish` only packages
# them because they are not gitignored.
/gen/*.sum

third_party/android_ndk
third_party/android_platform
third_party/catapult
third_party/llvm-build
third_party/rust-toolchain
